	</description>
	<files>
		<filename>component.php</filename>
		<filename>favicon.ico</filename>
		<filename>index.php</filename>
		<filename>template_preview.png</filename>
		<filename>template_thumbnail.png</filename>
		<filename>templateDetails.xml</filename>
		<folder>css</folder>
		<folder>fields</folder>
		<folder>html</folder>
		<folder>images</folder>
		<folder>img</folder>
		<folder>language</folder>
		<folder>less</folder>
		<folder>scripts</folder>
	</files>
	<positions>
		<position>debug</position>
		<position>position-0</position>
		<position>position-1</position>
		<position>position-2</position>
		<position>position-3</position>
		<position>position-4</position>
		<position>position-5</position>
		<position>position-6</position>
		<position>position-7</position>
		<position>position-8</position>
		<position>position-9</position>
		<position>position-10</position>
		<position>position-11</position>
		<position>position-12</position>
		<position>social</position>
		<position>mainmenu</position>
		<position>fontsize</position>
		<position>bottom</position>
		<position>copyright</position>
	</positions>
	<languages folder="language">
		<language tag="en-GB">en-GB/en-GB.tpl_jf_vihrea.ini</language>
		<language tag="en-GB">en-GB/en-GB.tpl_jf_vihrea.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="advanced"  addfieldpath="/templates/jf_vihrea/fields/">
			
				<field name="logoas" type="list" default=""
					label="Logo"
					description="Select an option">
						<option value="1">Use as image</option>
  						<option value="2">Use as text</option>
				</field>

				<field name="logoFile" class="" type="media" default=""
					label="TPL_JF_VIHREA_LOGO_LABEL"
					description="TPL_JF_VIHREA_LOGO_DESC" />
					
				<field name="sitetitle"  type="text" default=""
					label="JGLOBAL_TITLE"
					description="JFIELD_ALT_PAGE_TITLE_LABEL"
					filter="string" />

				<field name="fontresizer"
					type="radio"
					class="btn-group"
					default="1"
					label="TPL_JF_VIHREA_FONTRESIZER_LABEL"
					description="TPL_JF_VIHREA_FONTRESIZER_DESC">
						<option value="0">JNO</option>
						<option value="1">JYES</option>
				</field>
				
				<field name="social"
					type="radio"
					class="btn-group"
					default="1"
					label="Show Social Button"
					description="Select an option">
						<option value="0">JNO</option>
						<option value="1">JYES</option>
				</field>
				
				<field name="facebookicon" 
					type="radio" 
					class="btn-group"
					default="1"
					label="Show Facebook Icon"
					description="Select an option">
						<option value="0">JNO</option>
  						<option value="1">JYES</option>
				</field>
				
				<field name="facebooklink" type="text" default=""
					label="Facebook Link"
					description="Please add your facebook link here"
					filter="string" />
				
				<field name="twittericon" 
					type="radio"
					class="btn-group"
					default="1"
					label="Show Twitter Icon"
					description="Select an option">
						<option value="0">JNO</option>
  						<option value="1">JYES</option>
				</field>
				
				<field name="twitterlink" type="text" default=""
					label="Twitter Link"
					description="Please add your twitter link here"
					filter="string" />
				
				<field name="rssicon" 
					type="radio" 
					class="btn-group"
					default="1"
					label="Show RSS Icon"
					description="Select an option">
						<option value="0">JNO</option>
  						<option value="1">JYES</option>
				</field>
				
				<field name="rsslink" type="text" default=""
					label="RSS Link"
					description="Please add rss link here"
					filter="string" />
					
				<field name="map" type="radio" default="1"
					class="btn-group"
					label="Use map in contact"
					description="Select an option">
						<option value="0">No</option>
  						<option value="1">Yes</option>
				</field>
					
				<field name="latitude" type="text" default="51.508742"
					label="Latitude"
					description="Latitude"
					filter="string" />
					
				<field name="longitude" type="text" default="-0.120850"
					label="Longitude"
					description="Longitude"
					filter="string" />
					
				<field name="marker" type="radio" default="1"
					class="btn-group"
					label="Publish this marker"
					description="Select an option">
						<option value="0">No</option>
  						<option value="1">Yes</option>
				</field>
				
				<field name="markerdescription" type="textarea" default=""
					label="Description for marker"
					description="Enter plain text for a description on the maker." 
					rows="5" cols="30" filter="safehtml" />
					
				<field name="longlat" type="map" label="Google Map" description="" ></field>

			</fieldset>
		</fields>
	</config>
</extension>
